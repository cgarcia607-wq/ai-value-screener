# Copy to .env and fill in. .env is gitignored; this file is not.

# FRED API key — required for macro/credit series.
# Request one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Nasdaq Data Link (formerly Quandl) — needed if using Sharadar SF1
# for point-in-time fundamentals. Uncomment when that source is wired up.
# NASDAQ_DATA_LINK_KEY=your_nasdaq_data_link_key_here
